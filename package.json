{
	"name": "dennisu.com",
	"private": true,
	"version": "1.5.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/subset-fonts.ts && bun scripts/verify-email-obfuscation.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./scripts/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"verify:email": "bun scripts/verify-email-obfuscation.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/subset-font": "^2.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"subset-font": "^2.7.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@lucide/svelte": "^0.552.0"
	}
}
