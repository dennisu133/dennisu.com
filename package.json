{
	"name": "dennisu.com",
	"private": true,
	"version": "1.5.0",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/subset-fonts.ts --dev && vite dev",
		"build": "bun scripts/subset-fonts.ts && vite build && bun scripts/verify-email-obfuscation.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./scripts/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"verify:email": "bun scripts/verify-email-obfuscation.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/subset-font": "^2.3.0",
		"fontverter": "^2.0.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"rehype-slug": "^6.0.0",
		"sharp": "^0.35.5",
		"shiki": "^4.6.0",
		"subset-font": "^2.9.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@lucide/svelte": "^0.552.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
